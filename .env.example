# GEMINI_API_KEY: Required for Gemini AI image & link prompt analysis.
# Create a free-tier key at https://aistudio.google.com/apikey
# Set this in .env locally, in your host's Environment Variables (Render/Railway/etc.),
# or via Settings > Secrets in Google AI Studio.
GEMINI_API_KEY="YOUR_FREE_TIER_GEMINI_API_KEY"

# PORT: Server listening port (defaults to 3000; hosts like Render set this automatically).
PORT=3000

# APP_URL: Optional public URL where this app is hosted.
APP_URL="http://localhost:3000"
